  - m_Id: 2903790462537728
    m_Localized: Your next effect starts here
    m_Metadata:
      m_Items: []
  - m_Id: 2903790462537729
    m_Localized: 'Create an effect with VFX Creator to add it to this browser.

      Choose
      it from the list, then press Space to replay.'
    m_Metadata:
      m_Items: []
