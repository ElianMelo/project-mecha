  - m_Id: 769493409792
    m_Localized: 'STICK / D-PAD Move   {jump} Jump   {attack} Light attack   {dash}
      Dash

      {tech} Heavy attack   {skill1} 25 MP / {skill2} 40 MP / {skill3}
      60 MP   HOLD {attack} Portal

      {dash} + {jump} Rocket   then DOWN Mushidon  
      DOWN + {attack} Dive

      {menu} Menu   {diagnostics} Combat lab

      RT
      SMG   /   ENTER Chat'
