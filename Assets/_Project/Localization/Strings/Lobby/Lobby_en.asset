    m_Metadata:
      m_Items: []
  - m_Id: 551657472
    m_Localized: "DEPLOYING SQUAD\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 551657473
    m_Localized: '{0} / {1}  PILOTS READY'
    m_Metadata:
      m_Items: []
  - m_Id: 551657474
    m_Localized: "Squad confirmed. Preparing your expedition\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 551657475
    m_Localized: Ready up when equipped. Deployment begins when every pilot is ready.
    m_Metadata:
      m_Items: []
  - m_Id: 2099355648
    m_Localized: Create an expedition or join a lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 2116132864
    m_Localized: No open lobbies. Create one to invite other players.
    m_Metadata:
      m_Items: []
  - m_Id: 2116132865
    m_Localized: "{0} open lobbies \xB7 refreshes every second"
    m_Metadata:
      m_Items: []
  - m_Id: 2124521472
    m_Localized: Leave your current game or lobby first.
    m_Metadata:
      m_Items: []
  - m_Id: 2128715776
    m_Localized: Waiting for every pilot to be ready.
    m_Metadata:
      m_Items: []
  - m_Id: 2128715777
    m_Localized: Lobby joined. Press READY when you want to start.
    m_Metadata:
      m_Items: []
  - m_Id: 2132910080
    m_Localized: "Connecting through Unity Relay\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2132910081
    m_Localized: Expedition started.
    m_Metadata:
      m_Items: []
  - m_Id: 2132910082
    m_Localized: The game connection failed. Choose a lobby to try again.
    m_Metadata:
      m_Items: []
  - m_Id: 2132910083
    m_Localized: The host closed the lobby. Choose another expedition.
    m_Metadata:
      m_Items: []
  - m_Id: 2137104384
    m_Localized: "All pilots ready. Connecting through Unity Relay\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2141298688
    m_Localized: You left the expedition.
    m_Metadata:
      m_Items: []
  - m_Id: 2145492992
    m_Localized: "Unity services are busy. Retrying shortly\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2145492993
    m_Localized: Could not complete the lobby request.
    m_Metadata:
      m_Items: []
  - m_Id: 2145492994
    m_Localized: '  Try again.'
    m_Metadata:
      m_Items: []
